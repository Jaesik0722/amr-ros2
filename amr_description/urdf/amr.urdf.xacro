<?xml version="1.0"?>
<!--
  Towing AMR, generated from Product1_V0.2.stp (CATIA V5).

  Frames (REP-105): base_footprint on the ground below the wheel axle centre,
  base_link at the wheel axle centre (CAD point (0, 0, 36) mm). Visual meshes
  (full-resolution, CAD colours) and inertials come from tools/step_to_urdf.py; joint origins below are
  measured from cylindrical faces in the CAD (see tools/links.yaml).
  Collision geometry is primitive on purpose (Nav2, Gazebo, Isaac Sim).
-->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find amr_description)/urdf/amr_inertials.xacro"/>

  <!-- Wheels (CAD: tyre torus R77 r23 at y = +-187.1 mm). Match amr_base/config/base.yaml. -->
  <xacro:property name="wheel_radius" value="0.100"/>
  <xacro:property name="wheel_separation" value="0.3742"/>
  <xacro:property name="wheel_width" value="0.046"/>

  <xacro:property name="mesh_dir" value="package://amr_description/meshes"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/base_link.dae"/></geometry>
    </visual>
    <!-- Main body -->
    <collision>
      <origin xyz="-0.0015 0 0.073"/>
      <geometry><box size="0.267 0.274 0.218"/></geometry>
    </collision>
    <!-- Base plate extension under the hitch -->
    <collision>
      <origin xyz="-0.1685 0 -0.033"/>
      <geometry><box size="0.067 0.270 0.006"/></geometry>
    </collision>
    <!-- Top deck and lidar mast -->
    <collision>
      <origin xyz="-0.018 0 0.204"/>
      <geometry><box size="0.194 0.220 0.047"/></geometry>
    </collision>
    <!-- Livox Mid-360 -->
    <collision>
      <origin xyz="-0.018 0 0.2575"/>
      <geometry><cylinder radius="0.0325" length="0.061"/></geometry>
    </collision>
    <!-- Wireless charging receiver -->
    <collision>
      <origin xyz="0.1625 0 0.017"/>
      <geometry><box size="0.063 0.136 0.136"/></geometry>
    </collision>
    <xacro:inertial_base_link/>
  </link>

  <xacro:macro name="wheel" params="side y">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/${side}_wheel_link.dae"/></geometry>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:call macro="inertial_${side}_wheel_link"/>
    </link>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation/2}"/>
  <xacro:wheel side="right" y="${-wheel_separation/2}"/>

  <!-- Casters (CAD: wheel R20 at x = +-127, z = -44 mm). Visuals are in the base mesh. -->
  <xacro:macro name="caster" params="name x">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} 0 -0.080"/>
    </joint>
    <link name="${name}_link">
      <collision><geometry><sphere radius="0.020"/></geometry></collision>
    </link>
  </xacro:macro>
  <xacro:caster name="front_caster" x="0.127"/>
  <xacro:caster name="rear_caster" x="-0.127"/>

  <!--
    2-DOF towing hitch, two Dynamixel XM540-W270.
    Yaw axis: vertical, 176.8 mm behind the axle. Pitch axis: lateral, 42.2 mm behind yaw.
    The joint limits below are carried over from the previous URDF. They have not been
    measured against the mechanism, so they bound the model rather than the hardware.
  -->
  <joint name="hitch_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="hitch_yaw_link"/>
    <origin xyz="-0.1768 0 -0.0052" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="10.6" velocity="3.14"/>
  </joint>
  <link name="hitch_yaw_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/hitch_yaw_link.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.0127 0 0"/>
      <geometry><box size="0.091 0.048 0.038"/></geometry>
    </collision>
    <xacro:inertial_hitch_yaw_link/>
  </link>

  <joint name="hitch_pitch_joint" type="revolute">
    <parent link="hitch_yaw_link"/>
    <child link="hitch_pitch_link"/>
    <origin xyz="-0.0422 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="10.6" velocity="3.14"/>
  </joint>
  <link name="hitch_pitch_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/hitch_pitch_link.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.0225 0 0.0202"/>
      <geometry><box size="0.075 0.062 0.070"/></geometry>
    </collision>
    <xacro:inertial_hitch_pitch_link/>
  </link>

  <!-- Coupling pin hole at the hook tip (CAD: R5 hole at x = -268.6, z = 50.8 mm). -->
  <joint name="hitch_coupling_joint" type="fixed">
    <parent link="hitch_pitch_link"/>
    <child link="hitch_coupling_link"/>
    <origin xyz="-0.0496 0 0.0200"/>
  </joint>
  <link name="hitch_coupling_link"/>

  <!--
    Livox Mid-360, frame at the centre of the mounting face (CAD: x = -18.05, z = 263 mm).
    The sensor's point cloud origin sits above that face, and the offset between the two
    is not applied here: this frame is the mounting face, not the optical origin. The
    scan slice tolerates that; 3D LIO does not, so take the offset from the Mid-360
    manual before using the cloud for it.
  -->
  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="-0.0181 0 0.227" rpy="0 0 0"/>
  </joint>
  <link name="livox_frame"/>

  <!--
    RealSense D435 front/rear. '<name>_link' follows realsense2_description: on the
    zero-depth plane (4.2 mm behind the glass) at the left imager (+17.5 mm in the
    camera's y). The driver publishes the optical frames below these.
  -->
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.1164 0.0175 0.0965" rpy="0 0 0"/>
  </joint>
  <link name="front_camera_link"/>

  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin xyz="-0.1277 -0.0175 0.1181" rpy="0 0 ${pi}"/>
  </joint>
  <link name="rear_camera_link"/>

  <!-- RealSense T265 (front), centre of the window. Not supported by current librealsense. -->
  <joint name="front_t265_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_t265_link"/>
    <origin xyz="0.1297 0 0.045" rpy="0 0 0"/>
  </joint>
  <link name="front_t265_link"/>

  <!-- Wireless charging receiver coil, x out of the coil face (for Nav2 docking). -->
  <joint name="charging_rx_joint" type="fixed">
    <parent link="base_link"/>
    <child link="charging_rx_link"/>
    <origin xyz="0.194 0 0.017" rpy="0 0 0"/>
  </joint>
  <link name="charging_rx_link"/>
</robot>
